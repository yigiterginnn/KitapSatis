@model Category
@{
    ViewData["Title"] = "Kategoriyi Sil";
}

<h1>Kategoriyi Sil</h1>

<div class="alert alert-danger">
    <strong>@Model.Name</strong> kategorisini silmek istediğine emin misin?
    Bu kategoriye ait ürünler de silinecek.
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Evet, Sil</button>
    <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
</form>