@model List<Order>
@{
    ViewData["Title"] = "Siparişler";
}

<h1 class="mb-3">Siparişler</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">Henüz sipariş yok.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>No</th>
                <th>Tarih</th>
                <th>Müşteri</th>
                <th>Ürün Sayısı</th>
                <th>Toplam</th>
                <th>Durum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>#@order.Id</td>
                    <td>@order.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@order.FullName</td>
                    <td>@order.OrderItems.Sum(oi => oi.Quantity)</td>
                    <td>@order.TotalPrice.ToString("N2") ₺</td>
                    <td><span class="badge bg-secondary">@order.Status</span></td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-primary">Detay</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Home" asp-action="Index">← Admin Paneline Dön</a>