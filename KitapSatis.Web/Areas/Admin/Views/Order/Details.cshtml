@model Order
@{
    ViewData["Title"] = "Sipariş Detayı";
    var statuses = new[] { "Hazırlanıyor", "Kargoda", "Teslim Edildi", "İptal Edildi" };
}

<h1 class="mb-3">Sipariş #@Model.Id</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<div class="row">
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-header">Müşteri Bilgileri</div>
            <div class="card-body">
                <p><strong>Ad Soyad:</strong> @Model.FullName</p>
                <p><strong>Telefon:</strong> @Model.Phone</p>
                <p><strong>Adres:</strong> @Model.Address</p>
                <p class="mb-0"><strong>Tarih:</strong> @Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-header">Sipariş Durumu</div>
            <div class="card-body">
                <form asp-action="UpdateStatus" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <select name="status" class="form-select mb-3">
                        @foreach (var s in statuses)
                        {
                            <option value="@s" selected="@(s == Model.Status)">@s</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary">Durumu Güncelle</button>
                </form>
            </div>
        </div>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Ürün</th>
            <th>Adet</th>
            <th>Birim Fiyat</th>
            <th>Ara Toplam</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderItems)
        {
            <tr>
                <td>@item.Product?.Name</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("N2") ₺</td>
                <td>@((item.UnitPrice * item.Quantity).ToString("N2")) ₺</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">Toplam:</th>
            <th>@Model.TotalPrice.ToString("N2") ₺</th>
        </tr>
    </tfoot>
</table>

<a asp-action="Index">← Siparişlere Dön</a>