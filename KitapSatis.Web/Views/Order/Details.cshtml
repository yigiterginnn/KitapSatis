@model Order
@{
    ViewData["Title"] = "Sipariş Detayı";
}

<a asp-action="Index" class="d-inline-block mb-3">← Siparişlerim</a>

<h1 class="mb-3">Sipariş #@Model.Id</h1>

<div class="card mb-4">
    <div class="card-body">
        <p><strong>Tarih:</strong> @Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</p>
        <p><strong>Durum:</strong> <span class="badge bg-secondary">@Model.Status</span></p>
        <p><strong>Teslimat:</strong> @Model.FullName · @Model.Phone</p>
        <p class="mb-0"><strong>Adres:</strong> @Model.Address</p>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Kitap</th>
            <th>Adet</th>
            <th>Birim Fiyat</th>
            <th>Ara Toplam</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderItems)
        {
            <tr>
                <td>@item.Product?.Name</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("N2") ₺</td>
                <td>@((item.UnitPrice * item.Quantity).ToString("N2")) ₺</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">Toplam:</th>
            <th>@Model.TotalPrice.ToString("N2") ₺</th>
        </tr>
    </tfoot>
</table>