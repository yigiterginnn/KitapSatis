@model Product
@{
    ViewData["Title"] = Model.Name;
}

<a asp-action="Index" class="d-inline-block mb-3">← Tüm Kitaplar</a>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-md-4 mb-4">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded shadow-sm" />
        }
        else
        {
            <div class="bg-light rounded d-flex align-items-center justify-content-center"
                 style="height: 400px; font-size: 6rem;">📚</div>
        }
    </div>
    <div class="col-md-8">
        <span class="badge bg-secondary mb-2">@Model.Category?.Name</span>
        <h1>@Model.Name</h1>
        <p class="fs-5 text-muted">@Model.Author</p>
        <p class="fs-3 fw-bold">@Model.Price.ToString("N2") ₺</p>

        @if (Model.Stock > 0)
        {
         <p class="text-success">Stokta var (@Model.Stock adet)</p>
@if (User.Identity?.IsAuthenticated == true)
{
    <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-2" style="max-width: 260px;">
        <input type="hidden" name="productId" value="@Model.Id" />
        <input type="number" name="quantity" value="1" min="1" max="@Model.Stock" class="form-control" style="width: 80px;" />
        <button type="submit" class="btn btn-primary">Sepete Ekle</button>
    </form>
}
else
{
    <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Context.Request.Path"
       class="btn btn-primary">Sepete eklemek için giriş yap</a>
}
        }
        else
        {
            <p class="text-danger">Stokta yok</p>
        }

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <hr />
            <h5>Kitap Hakkında</h5>
            <p>@Model.Description</p>
        }
    </div>
</div>